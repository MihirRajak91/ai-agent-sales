# ========= App =========
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kathmandu
PRINT_SETTINGS_ON_STARTUP=false

# ========= Auth (JWT) =========
JWT_SECRET=replace-with-dev-secret
JWT_ALG=HS256
JWT_TTL_SECONDS=3600
JWT_ISS=auth
JWT_AUD=api

# ========= MongoDB =========
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=multi_tenant_sales

# ========= Gemini (LLM + Embeddings; Developer API) =========
GEMINI_API_KEY=replace-with-gemini-key
LLM_MODEL=models/gemini-2.5-flash
EMBED_MODEL=models/text-embedding-004
EMBED_OUTPUT_DIM=768

# ========= Pinecone =========
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX=kb-embeddings

# ========= Email Provider =========
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Sales Bot
EMAIL_FROM_ADDRESS=bot@example.com
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true

# ========= Google Calendar (OAuth) =========
GOOGLE_CALENDAR_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# ========= Google Service Account (optional) =========
GOOGLE_SERVICE_ACCOUNT_TYPE=
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SERVICE_ACCOUNT_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SERVICE_ACCOUNT_CLIENT_X509_CERT_URL=
GOOGLE_SERVICE_ACCOUNT_UNIVERSE_DOMAIN=googleapis.com

# ========= Frontend =========
FRONTEND_URL=http://localhost:8001
